# Copy to `.env.local` and fill in real values (`.env.local` is gitignored).

# ============================================
# REQUIRED: Gemini API (Primary Image Generation)
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey
# This is the main API used for generating vehicle accessory preview images
VITE_GEMINI_API_KEY=

# Optional: Choose Gemini model (can also be set in the app UI)
# Options: gemini-3-pro-image-preview (best quality), gemini-3.1-flash-image-preview (balanced, default), gemini-2.5-flash-image (fastest)
# VITE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Advanced: Override Gemini API endpoint (usually not needed)
# VITE_GEMINI_API_BASE=


# ============================================
# REQUIRED: Cloudinary (Image Upload & Hosting)
# ============================================
# Get credentials from: https://console.cloudinary.com/
# 1. Cloud Name: Dashboard → Settings → Product environment credentials
# 2. Upload Preset: Settings → Upload → Add upload preset → Set to "Unsigned"
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: Cloudinary Admin API (for deleting uploaded images)
# NOTE: Exposing secrets in frontend is not secure - only use for POC/demo purposes
# VITE_CLOUDINARY_API_KEY=
# VITE_CLOUDINARY_API_SECRET=


# ============================================
# OPTIONAL: Alternative Image Generation Providers
# ============================================
# NanoBanana API (alternative to Gemini)
# Get key from: https://nanobananaapi.ai
# VITE_NANOBANANA_API_KEY=

# Vertex AI (Google Cloud Imagen - alternative to Gemini)
# Requires Google Cloud project with Vertex AI enabled
# VITE_VERTEX_PROJECT_ID=
# VITE_VERTEX_LOCATION=us-central1
# VITE_VERTEX_ACCESS_TOKEN=
# VITE_VERTEX_API_KEY=
# Optional model overrides:
# VITE_VERTEX_TEXT_MODEL=imagen-4.0-fast-generate-001
# VITE_VERTEX_EDIT_MODEL=imagen-3.0-capability-001
